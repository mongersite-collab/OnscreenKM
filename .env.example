# ============================================================
# OnscreenKM Security Server - نمونه تنظیمات
# این فایل را کپی کن به نام .env و مقادیر را پر کن،
# یا همین متغیرها را قبل از اجرای سرور export کن.
# ============================================================

# --- شبکه ---
PORT=4173
KM_HOST=0.0.0.0

# --- امنیت ---
# اگر خالی بگذاری، سرور یک کلید تصادفی می‌سازد و در server/data/.session-secret ذخیره می‌کند
KM_SECRET=
KM_SESSION_DAYS=7

# --- کد مخصوص دولپر (حتماً عوضش کن!) ---
KM_DEV_CODE=KM-OWNER-2026-OMEGA-7X4Q
KM_DEV_EMAIL=zarvandikomeil@gmail.com
KM_DEV_NAME=Komeil (Developer)

# --- توکن‌ها ---
KM_FREE_TOKENS=300
KM_DAILY_TOKENS=10
KM_COST_IMAGE=10
KM_COST_VIDEO=20
KM_COST_THUMB=20
KM_COST_EDITVID=25
KM_COST_EDITIMG=10
# هزینه هر بار استفاده (وقتی عددهای واقعی را فرستادی همین‌ها را عوض کن)
KM_COST_IMAGE=1
KM_COST_VIDEO=1
KM_COST_THUMB=1
KM_COST_EDITVID=1
KM_COST_EDITIMG=1

# --- ورود با گوگل ---
# از https://console.cloud.google.com  →  OAuth 2.0 Client ID (Web)
KM_GOOGLE_CLIENT_ID=

# --- کد ایمیلی ---
KM_CODE_TTL_MIN=10
KM_CODE_MAX_TRIES=5
# اگر 0 باشد، وقتی SMTP تنظیم نشده کد در پاسخ برنمی‌گردد
KM_EXPOSE_CODE=1

# --- SMTP (برای فرستادن کد به جیمیل) ---
# برای Gmail باید App Password بسازی (نه رمز اصلی حساب)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=zarvandikomeil@gmail.com
SMTP_PASS=
SMTP_FROM=OnscreenKM <zarvandikomeil@gmail.com>
SMTP_STARTTLS=0
SMTP_TIMEOUT_MS=15000

# --- محدودیت‌ها ---
KM_MAX_BODY=65536
KM_AUTH_PER_MIN=12
KM_CODE_PER_10MIN=5
KM_SPEND_PER_MIN=40
KM_FAILED_LOCK=6
KM_LOCK_MINUTES=15

# --- HTTPS (اختیاری) ---
KM_TLS_KEY=
KM_TLS_CERT=

# لینک مستقیم درگاه پرداخت (ویپاد / زرین‌پال / ایدی‌پی)
KM_PAY_LINK=

# سقف تولید روزانه‌ی هر ابزار و فاصله‌ی بین دو تولید
KM_DAILY_TOOL_CAP=15
KM_COOLDOWN_SEC=12

KM_COST_AUDIO=20
